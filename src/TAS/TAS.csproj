<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TAS</AssemblyName>
    <Product>TAS - Temperature Alert System</Product>
    <Version>1.0.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- Decodes whatever image format an alert image URL returns (WebP, PNG, JPEG, GIF, ...) so it can be cached as PNG. -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Official signed installer from https://github.com/namazso/PawnIO.Setup/releases (2.2.0). -->
    <EmbeddedResource Include="Resources\PawnIO_setup.exe" LogicalName="TAS.Resources.PawnIO_setup.exe" />
  </ItemGroup>

</Project>
